# Copy to .env and fill in. Only MERMAID_API_KEY is usually needed for --stdio.

# Origin of the Mermaid deployment. No trailing slash, no /api/v1 suffix.
MERMAID_BASE_URL=https://mermaid.alward.dev

# Dashboard API key (ek_...). Required for --stdio; ignored in HTTP mode,
# where the key must arrive on each request.
MERMAID_API_KEY=

# HTTP mode only
HOST=0.0.0.0
PORT=8120
MCP_PATH=/mcp

# Abort an upstream call after this many ms.
REQUEST_TIMEOUT_MS=15000
# Max JSON body accepted on the MCP endpoint (diagrams can be large).
MAX_BODY_SIZE=2mb

# debug | info | warn | error | silent
LOG_LEVEL=info

# Comma-separated browser origins, or * to allow any.
CORS_ORIGINS=*

# Comma-separated Host header allow-list. Unset = no DNS-rebinding check.
# ALLOWED_HOSTS=mermaid.example.com
